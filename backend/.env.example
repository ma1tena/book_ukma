# Скопіюйте цей файл у .env і заповніть (.env у git не потрапляє — він у .gitignore).

# ── Обовʼязково на проді: довгий випадковий рядок
SECRET_KEY=dev-secret-change-me

# ── Хто стає адміністратором (пошти через кому)
ADMIN_EMAILS=

# ── Режим «гість»: true — дозволити реєстрацію з будь-якою поштою (не @ukma.edu.ua)
ALLOW_GUESTS=false

# ── Адреси (локально — як нижче; на проді — домени Vercel і Render)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# ── Пошта для листів із кодом. Без SMTP_HOST код друкується в терміналі (dev-режим)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Вхід через Office 365 (Microsoft Entra ID). Без цих трьох значень кнопка неактивна
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
