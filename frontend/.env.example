# Для продакшену (Vercel): адреса бекенду на Render. Локально не потрібно — працює проксі.
VITE_API_URL=https://your-backend.onrender.com

# Публічна адреса сайту (для canonical, Open Graph і sitemap.xml). На Vercel можна не задавати —
# береться з VERCEL_PROJECT_PRODUCTION_URL. Без неї sitemap.xml не генерується.
VITE_SITE_URL=https://your-site.vercel.app
